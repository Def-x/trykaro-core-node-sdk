{
  "name": "@defx/storefront-core",
  "version": "1.2.0",
  "description": "Shared UI and logic for Defx multi-store ecommerce storefronts",
  "type": "module",
  "packageManager": "yarn@4.12.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./stripe": {
      "import": "./dist/stripe.js",
      "default": "./dist/stripe.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@clerk/nextjs": "^7.2.0",
    "@stripe/react-stripe-js": ">=2",
    "@stripe/stripe-js": ">=2",
    "js-cookie": "^3.0.5",
    "lodash": ">=4",
    "lucide-react": ">=0.300.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@clerk/nextjs": {
      "optional": true
    },
    "@stripe/react-stripe-js": {
      "optional": true
    },
    "@stripe/stripe-js": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "lodash": "^4.18.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  }
}
